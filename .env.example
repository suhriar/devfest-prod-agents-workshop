# File ini disalin menjadi .env oleh langkah setup di README.
GOOGLE_CLOUD_PROJECT=isi-project-id-kamu
# "global" = endpoint Gemini global, model terbaru selalu tersedia di sini.
GOOGLE_CLOUD_LOCATION=global
# Pakai Gemini lewat Vertex AI (tidak perlu API key, cukup login gcloud).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
MODEL=gemini-3.5-flash

# Nama service & region Cloud Run
SERVICE_NAME=kuliner-agent
REGION=us-central1
